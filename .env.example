# 复制为 .env 并仅在服务器安全目录中填写真实值；不要提交 .env
ENTERPRISE_RISK_IMAGE_TAG=8b45901
ENTERPRISE_RISK_PORT=8092
ENTERPRISE_RISK_FRONTEND_BIND_PORT=8093
TZ=Asia/Shanghai

# MySQL 8（建议使用独立云数据库或独立主机）
ENTERPRISE_RISK_DB_URL=jdbc:mysql://DB_HOST:3306/enterprise_risk?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia%2FShanghai&useSSL=true&allowPublicKeyRetrieval=false
ENTERPRISE_RISK_DB_USERNAME=enterprise_risk_app
ENTERPRISE_RISK_DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
ENTERPRISE_RISK_FLYWAY_LOCATIONS=classpath:db/migration-mysql,classpath:db/mysqlmigration

# 使用随机生成的至少 32 字符密钥；密钥变更会导致已有 JWT/密文无法解密
ENTERPRISE_RISK_JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
ENTERPRISE_RISK_KEY_ENCRYPTION_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
ENTERPRISE_RISK_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
ENTERPRISE_RISK_REQUIRE_BOOTSTRAP_ADMIN_PASSWORD=true

ENTERPRISE_RISK_TIANYANCHA_ENDPOINT=https://mcp.tianyancha.com/mcp
ENTERPRISE_RISK_TIANYANCHA_TIMEOUT_SECONDS=30
